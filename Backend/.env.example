PORT=3000
ENABLE_TEST_UI=true
MONGO_URI=mongodb://127.0.0.1:27017/koinonia_pilot
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
# Opcional: URL completa del endpoint de enriquecimiento. Vacío = ranking local.
RECOMMENDER_URL=
RECOMMENDER_TOKEN=

# Cloudinary: solo backend. Las tres variables son necesarias para habilitar fotos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Render tiene un proxy delante del servicio; local = 0.
TRUST_PROXY_HOPS=0

# Correo: las tres juntas para recuperación e invitaciones; registro no lo exige durante la pausa.
RESEND_API_KEY=
MAIL_FROM=
APP_PUBLIC_URL=

# Comprobación de direcciones: clave privada de Geoapify, solo backend.
GEOAPIFY_API_KEY=

# Activar solo tras verificar un administrador y probar el envío real.
ENFORCE_LEGACY_EMAIL_VERIFICATION=false

# Piloto: pausa la exigencia de correo, conserva límites contra abuso.
EMAIL_VERIFICATION_REQUIRED=false

# Políticas independientes: no activan funciones todavía pendientes.
ADMIN_MFA_REQUIRED=false
CAPTCHA_MODE=off
MAIL_QUEUE_ENABLED=false
ADVANCED_ABUSE_MODE=observe
SECURITY_CLEANUP_MODE=off
# CAPTCHA: off | observe | enforce (requiere claves y riesgo). ABUSO enforce sigue reservado.
# LIMPIEZA: off | dry-run | apply. Aplicación solo mediante CLI explícita; nunca borra cuentas.

# MFA voluntario: clave exclusiva de 32 bytes en base64. Nunca usar JWT_SECRET.
# Formato JSON: {"v1":"<clave-base64>"}; conservar versiones previas para descifrar.
MFA_ENCRYPTION_KEYS=
MFA_ACTIVE_KEY_ID=

# Opcional: redes de proxies confiables; no combinar con TRUST_PROXY_HOPS > 0.
TRUST_PROXY_CIDRS=

# CAPTCHA adaptativo: aplicación obligatoria permanece desactivada (CAPTCHA_MODE=off).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Cola preparada: mantener MAIL_QUEUE_ENABLED=false durante el piloto.
MAIL_QUEUE_ENCRYPTION_KEYS=
MAIL_QUEUE_ACTIVE_KEY_ID=

# Webhook opcional de Resend: secreto distinto de la API key. No habilita envíos.
RESEND_WEBHOOK_SECRET=
MAIL_WEBHOOK_SOURCE=provider

# Retenciones de artefactos; ver docs/security-maintenance.md. No activan limpieza por lotes.
SECURITY_ACCOUNT_DELETION_ENABLED=false
SECURITY_TOKEN_RETENTION_HOURS=24
SECURITY_CHALLENGE_RETENTION_MINUTES=60
SECURITY_COUNTER_RETENTION_HOURS=1
SECURITY_CAPTCHA_RETENTION_HOURS=24
SECURITY_MAIL_RETENTION_DAYS=7
SECURITY_EVENT_RETENTION_DAYS=7
SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_MAINTENANCE_BATCH_SIZE=100
SECURITY_MAINTENANCE_MAX_BATCHES=20
